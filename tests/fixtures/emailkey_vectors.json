    {"why": "含雙引號", "in": ["x\"y", "example.com"], "join": "@"},
    {"why": "含反斜線", "in": ["x\\y", "example.com"], "join": "@"},
    {"why": "中間有空白", "in": ["parent a", "example.com"], "join": "@"},
