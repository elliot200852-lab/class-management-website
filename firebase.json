{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local", ".env*", ".test-run"]
    }
  ],
  "hosting": {
    "public": "site",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
          {"key": "X-Content-Type-Options", "value": "nosniff"},
          {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
        ]
      },
      {
        "source": "/js/site-config.js",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "/js/core/queries.js",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      }
    ]
  },
  "emulators": {
    "auth": {"port": 9099},
    "firestore": {"port": 8080},
    "hosting": {"port": 5000},
    "ui": {"enabled": false}
  }
}
